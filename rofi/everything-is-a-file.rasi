configuration {
    modi:           "drun,run";
    show-icons:     false;
    display-drun:   "everything is a file :)";
    display-run:    "everything is a file :)";
    font:           "JetBrainsMono Nerd Font 10";
}

* {
    bg:          rgba(0, 0, 0, 0.92);
    fg:          #7a7a7a;
    fg-active:   #ffffff;
    border-col:  rgba(0, 0, 0, 0.92);	
    transparent: rgba(0, 0, 0, 0);
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @border-col;
    border-radius:    0px;
    width:            420px;
    location:         center;
    anchor:           center;
    padding:          16px;
}

mainbox {
    background-color: @transparent;
    children: [ inputbar, listview ];
    spacing: 18px;
}

inputbar {
    background-color: @transparent;
    text-color:       @fg;
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    background-color: @transparent;
    text-color:       @fg;
}

entry {
    background-color: @transparent;
    text-color:       @fg-active;
    placeholder:      "";
    placeholder-color: @fg;
    cursor:           text;
}

listview {
    background-color: @transparent;
    lines:            8;
    spacing:          4px;
    fixed-height:     false;
    border:           0px;
    scrollbar:        false;
}

element {
    background-color: @transparent;
    text-color:       @fg;
    padding:          4px 2px;
}

element selected {
    background-color: @transparent;
    text-color:       @fg-active;
}

element-text {
    background-color: @transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

scrollbar {
    handle-color: @transparent;
}

