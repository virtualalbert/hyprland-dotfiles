-- MONITOR SETUP

-- Syntax: monitor = <name>, <resolution>@<refresh>, <position>, <scale>

-- Generated by hyprlang2lua. Review TODOs before reloading Hyprland.

hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = "1",
})

-- ENVIRONMENT VARIABLES

hl.env("XCURSOR_THEME", "Bibata-Original-Classic")
hl.env("XCURSOR_SIZE", "22")
hl.env("HYPRCURSOR_THEME", "Bibata-Original-Classic")
hl.env("HYPRCURSOR_SIZE", "22")
hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")
hl.env("QT_QPA_PLATFORM", "wayland")
hl.env("QT_QPA_PLATFORMTHEME", "qt5ct")
hl.env("QT_WAYLAND_DISABLE_WINDOWDECORATION", "1")
hl.env("QT_AUTO_SCREEN_SCALE_FACTOR", "1")
hl.env("QT_STYLE_OVERRIDE", "kvantum")

-- INPUT CONFIG

hl.window_rule({
    match = {
        class = "thunar",
    },
    border_size = 0,
    rounding = 0,
})

hl.curve("smoothOut", { type = "bezier", points = { { 0.36, 0 }, { 0.66, -0.56 } } })
hl.curve("smoothIn", { type = "bezier", points = { { 0.25, 1 }, { 0.5, 1 } } })
hl.curve("overshot", { type = "bezier", points = { { 0.05, 0.9 }, { 0.1, 1.05 } } })
hl.animation({
    leaf = "windows",
    enabled = true,
    speed = 4,
    bezier = "overshot",
    style = "popin 80%",
})
hl.animation({
    leaf = "windowsOut",
    enabled = true,
    speed = 4,
    bezier = "smoothOut",
    style = "popin 80%",
})
hl.animation({
    leaf = "windowsMove",
    enabled = true,
    speed = 3,
    bezier = "smoothIn",
})
hl.animation({
    leaf = "fade",
    enabled = true,
    speed = 4,
    bezier = "smoothIn",
})
hl.animation({
    leaf = "workspaces",
    enabled = true,
    speed = 3,
    bezier = "smoothIn",
    style = "slide",
})
hl.animation({
    leaf = "border",
z    enabled = true,
    speed = 5,
    bezier = "default",
})

local mod = "SUPER"
local terminal = "kitty"
local fileManager = "nautilus"
local menu = "cd .config && cd rofi && cd launchers && cd type-5 && ./launcher.sh" -- app launcher — install with: sudo dnf install wofi

hl.bind("Print", hl.dsp.exec_cmd("grim -g \"$(slurp)\" ~/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%s').png"))

local powermenu = "cd .config/rofi/powermenu/type-1 && ./powermenu.sh"

hl.bind("SHIFT + Print", hl.dsp.exec_cmd("grim -g \"$(slurp)\" - | wl-copy"))

hl.bind(mod .. " + RETURN", hl.dsp.exec_cmd(terminal))
hl.bind(mod .. " + E", hl.dsp.exec_cmd(fileManager))
hl.bind(mod .. " + Q", hl.dsp.window.close())
hl.bind(mod .. " + SHIFT + E", hl.dsp.exit())
hl.bind(mod .. " + N", hl.dsp.exec_cmd(powermenu))
hl.bind(mod .. " + R", hl.dsp.exec_cmd("rofi -show drun -theme ~/.config/rofi/everything-is-a-file.rasi"))

hl.bind(mod .. " + V", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mod .. " + F", hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" }))
hl.bind(mod .. " + P", hl.dsp.window.pseudo())

hl.bind(mod .. " + M", hl.dsp.exec_cmd("~/.config/eww/toggle.sh"))
hl.bind(mod .. " + H", hl.dsp.focus({ direction = "left" }))
hl.bind(mod .. " + L", hl.dsp.focus({ direction = "right" }))
hl.bind(mod .. " + K", hl.dsp.focus({ direction = "up" }))
hl.bind(mod .. " + J", hl.dsp.focus({ direction = "down" }))

hl.bind(mod .. " + 1", hl.dsp.focus({ workspace = 1 }))
hl.bind(mod .. " + 2", hl.dsp.focus({ workspace = 2 }))
hl.bind(mod .. " + 3", hl.dsp.focus({ workspace = 3 }))
hl.bind(mod .. " + 4", hl.dsp.focus({ workspace = 4 }))
hl.bind(mod .. " + 5", hl.dsp.focus({ workspace = 5 }))
hl.bind(mod .. " + SHIFT + 0", hl.dsp.focus({ workspace = 6 }))

hl.bind(mod .. " + SHIFT + 1", hl.dsp.window.move({ workspace = 1 }))
hl.bind(mod .. " + SHIFT + 2", hl.dsp.window.move({ workspace = 2 }))
hl.bind(mod .. " + SHIFT + 3", hl.dsp.window.move({ workspace = 3 }))
hl.bind(mod .. " + SHIFT + 4", hl.dsp.window.move({ workspace = 4 }))
hl.bind(mod .. " + SHIFT + 5", hl.dsp.window.move({ workspace = 5 }))

hl.bind(mod .. " + mouse:272", hl.dsp.window.drag())
hl.bind(mod .. " + mouse:273", hl.dsp.window.resize())

hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)}' > $WOBSOCK"))
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)}' > $WOBSOCK"))
hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("brightnessctl set +10% && brightnessctl -m | awk -F, '{print $4}' | tr -d '%' > $WOBSOCK"))
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl set 10%- && brightnessctl -m | awk -F, '{print $4}' | tr -d '%' > $WOBSOCK"))

hl.env("WOBSOCK", "$XDG_RUNTIME_DIR/wob.sock")

hl.bind(mod .. " + A", hl.dsp.submap("fastedit"))
hl.define_submap("fastedit", function()
    hl.bind("CTRL + right", hl.dsp.window.resize({ x = 10, y = 0, relative = true }))
    hl.bind("CTRL + left", hl.dsp.window.resize({ x = -10, y = 0, relative = true }))
    hl.bind("CTRL + up", hl.dsp.window.resize({ x = 0, y = -10, relative = true }))
    hl.bind("CTRL + down", hl.dsp.window.resize({ x = 0, y = 10, relative = true }))
    hl.bind("left", hl.dsp.focus({ direction = "left" }), { repeating = true })
    hl.bind("right", hl.dsp.focus({ direction = "right" }), { repeating = true })
    hl.bind("up", hl.dsp.focus({ direction = "up" }), { repeating = true })
    hl.bind("down", hl.dsp.focus({ direction = "down" }), { repeating = true })
    hl.bind("SHIFT + left", hl.dsp.window.move({ direction = "l" }))
    hl.bind("SHIFT + right", hl.dsp.window.move({ direction = "r" }))
    hl.bind("SHIFT + up", hl.dsp.window.move({ direction = "u" }))
    hl.bind("SHIFT + down", hl.dsp.window.move({ direction = "d" }))
    hl.bind("escape", hl.dsp.submap("reset"))
end)

hl.config({
    input = {
        kb_layout = "us",
        follow_mouse = 1, -- 1 = focus follows mouse hover
        touchpad = {
            natural_scroll = true,
        },
        sensitivity = 0, -- mouse sensitivity, -1.0 to 1.0, 0 = default
    },
    -- GENERAL LAYOUT SETTINGS
    general = {
        gaps_in = 4,
        gaps_out = 1,
        border_size = 0,
        col = {
            active_border = 111111,
            inactive_border = "rgba(595959aa)",
        },
        layout = "dwindle",
    },
    -- DECORATION 
    decoration = {
        rounding = 0, -- corner radius on windows, in px
        blur = {
            enabled = false,
            --       size = 3
            --       passes = 1
        },
    },
    -- ANIMATIONS
    animations = {
        enabled = true,
        -- windows: opening/closing/moving/resizing
        -- fade: used for things like layer transitions, dimming
        -- workspaces: the switch animation when you change workspace
        -- border: color transition speed on focus change
    },
    -- KEYBINDS
    -- $mod is a variable — SUPER is the Windows/Cmd key. Defining it once
    -- means I can change your modifier key everywhere by editing one line.
    -- Screenshot: select region, save to file + copy to clipboard
    -- Screenshot: select region, copy to clipboard only (no file)
    -- --- App launching ---
    --bind = $mod, D, exec, $menu
    --bind = $mod, J, togglesplit        
    --bind = $mod, B, exec, 
    -- --- Workspaces ---
    -- up to 10 numbered workspaces
    -- Move focused window
    -- --- Mouse-driven window management ---
    -- bindm = well in my words any thing you click after bindm takes bind i mean mod firstit more like mod (25,65), mod right click :)
    --WOB
    -- AUTOSTART 
    -- WELL IN CASE YOU FORGOT YOUR MOUSE
})

hl.on("hyprland.start", function()
    hl.exec_cmd("waybar")
    hl.exec_cmd("hyprpaper & sleep 1 && hyprctl hyprpaper wallpaper \"eDP-1,~/Pictures/wallpaper.jpg\"")
    hl.exec_cmd("hypridle")
    hl.exec_cmd("mkfifo -p $XDG_RUNTIME_DIR/wob.sock 2>/dev/null; tail -f $XDG_RUNTIME_DIR/wob.sock | wob")
end)

