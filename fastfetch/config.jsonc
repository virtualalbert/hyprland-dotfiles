{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "padding": {
      "right": 3
    }
  },

  "display": {
    "separator": " "
  },

  "modules": [
    "break",

    {
      "type": "title",
      "format": "being a low level lover forever :)"
    },
    {
      "type": "os",
      "key": "OS"
    },

    {
      "type": "kernel",
      "key": "Kernel"
    },

    {
      "type": "wm",
      "key": "WM"
    },

    {
      "type": "shell",
      "key": "Shell"
    },

    {
      "type": "terminal",
      "key": "Terminal"
    },

    {
      "type": "cpu",
      "key": "CPU"
    },

    {
      "type": "memory",
      "key": "Memory"
    },

    {
      "type": "uptime",
      "key": "Uptime"
    }
  ]
}
